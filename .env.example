# Local SQLite is no longer the Prisma provider. Use Postgres for local and Vercel.

# Docker (docker compose up -d)
# DATABASE_URL="postgresql://aether:aether@localhost:5432/aether_clinics?schema=public"

# Hosted Postgres (Neon / Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

AUTH_SECRET="change-me-to-a-long-random-string"
MPESA_WEBHOOK_SECRET="change-me"
